# Copy to .env and adjust. All values below are the defaults.
# Database. SQLite (below) is for local development: a single file, one machine, one backend process. Anything deployed, or
# anything that must survive a redeploy, needs PostgreSQL, for example
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# (postgres:// and postgresql:// are accepted and use the bundled psycopg driver). APP_ENV=production refuses SQLite unless
# ALLOW_SQLITE_IN_PRODUCTION=true, which is only for a single process whose file sits on a persistent volume.
DATABASE_URL=sqlite:///./data/insider_threat.db
# ALLOW_SQLITE_IN_PRODUCTION=false
# Seconds a writer waits for the SQLite write lock (or a PostgreSQL connection from the pool) before failing with HTTP 503
DB_BUSY_TIMEOUT_SECONDS=30
# PostgreSQL connection pool (ignored for SQLite)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
# Dashboard totals cover this many days; list endpoints return at most MAX_PAGE_SIZE rows per request
DASHBOARD_WINDOW_DAYS=30
MAX_PAGE_SIZE=500
# Dashboard polling: seconds between change-token checks and how long fetched panels are reused (read by the Streamlit apps)
# SOC_REFRESH_SECONDS=3
# SOC_CACHE_SECONDS=25
# Seconds in which a repeated identical portal action (double click, rerun) is recorded once
# PORTAL_REPEAT_WINDOW_SECONDS=3
# Leave SECRET_KEY empty for local development (a random per-machine key is created in data/.local_secret), or run
# `python app.py setup` to write a random one here. Production (APP_ENV=production) refuses to start without a strong value
# (32+ random characters) from the environment or your host's secret manager. There is no default.
SECRET_KEY=
SESSION_TTL_MINUTES=480
DISPLAY_TIMEZONE=Asia/Kolkata
# Explicit origins only (no wildcard). The dashboards call the API server-side, so browsers normally need none of these.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8503,http://127.0.0.1:8503
AUTO_SEED=true
# Argon2id password-hash cost (the defaults are sensible; lower only for tests)
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=2
# Demo account passwords are random and generated on first start into data/demo_credentials.local.json (git-ignored);
# view them with `python app.py credentials`. In production supply them as the secret DEMO_PASSWORDS_JSON (a JSON object
# of username to password) or set AUTO_SEED=false. They are never stored in the repository.
# DEMO_PASSWORDS_JSON=
# DEMO_CREDENTIALS_FILE=data/demo_credentials.local.json

# Offline scenario lab (tests and threshold calibration only; needs the lab/ package, which the container image does not
# contain). The application refuses to start with LAB_MODE=true when APP_ENV=production.
LAB_MODE=false
# Password for the privileged account the lab creates. Empty = derived from SECRET_KEY (no fixed default).
SIMULATION_PRIVILEGED_PASSWORD=
# Local demo: every client connects from loopback, so attribute it to the employee's registered workstation IP.
MAP_LOOPBACK_TO_WORKSTATION=true

# Deployment. APP_ENV=production refuses to start with the demo SECRET_KEY (needs >= 32 random characters).
APP_ENV=development
# Split hosting (dashboards on another host): set the SAME random value (>= 24 characters) on the backend and on every
# dashboard. Requests carrying it are attributed to the employee's registered workstation IP. Empty = disabled.
TRUSTED_FRONTEND_KEY=
# Seconds the dashboards wait for the API (raise it for a free host that sleeps when idle)
API_TIMEOUT_SECONDS=20
# Failed sign-ins per employee ID before a temporary lockout, and its length
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=300
# Failed sign-ins from one source address before it is locked out for the window below
LOGIN_IP_MAX_FAILURES=20
LOGIN_IP_WINDOW_SECONDS=300
# Per-minute limits per caller: administrator state changes, expensive actions (retrain, reset, payroll export), employee actions
RATE_LIMITS_ENABLED=true
RATE_LIMIT_SENSITIVE_PER_MINUTE=30
RATE_LIMIT_HEAVY_PER_MINUTE=6
RATE_LIMIT_EMPLOYEE_PER_MINUTE=60
# Largest accepted request body, in bytes
MAX_REQUEST_BYTES=1000000
# HTTPS: the backend does not terminate TLS itself; put it behind a TLS-terminating host or proxy. With REQUIRE_HTTPS=true (the
# default when APP_ENV=production) plain-HTTP requests are refused except from loopback and the health check. Behind a proxy
# you control, set TRUST_FORWARDED_PROTO=true so X-Forwarded-Proto is honoured.
# REQUIRE_HTTPS=true
TRUST_FORWARDED_PROTO=false
# Interactive API docs (/docs): on in development, off in production unless enabled here
# ENABLE_API_DOCS=false
# Simulated containment requests one administrator may submit per minute (HTTP 429 beyond it)
CONTAINMENT_MAX_PER_MINUTE=30

# Where the backend listens (python app.py) and where the dashboards find it. Change both if port 8000 is busy.
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# Detection engine (rule severities, weights and parameters live in backend/detection_rules.json)
CORRELATION_WINDOW_MINUTES=240
INVESTIGATION_WINDOW_HOURS=24
BASELINE_DAYS=30
# Attack-confidence severity thresholds (0-100): Normal < SUSPICIOUS <= Suspicious < HIGH <= High Risk < CRITICAL <= Critical
THREAT_SUSPICIOUS_THRESHOLD=25
THREAT_HIGH_THRESHOLD=50
THREAT_CRITICAL_THRESHOLD=80
# Lowest severity that raises an alert (normal | suspicious | high_risk | critical)
ALERT_MIN_SEVERITY=critical
BULK_RECORD_THRESHOLD=500
BUSINESS_HOURS_START=7
BUSINESS_HOURS_END=19
# DETECTION_RULES_PATH=backend/detection_rules.json

# Machine learning (Isolation Forest). The model is trained on first start if the file is missing.
ML_MODEL_PATH=ml/artifacts/isolation_forest.joblib
ML_AUTO_TRAIN=true

# Single-container deployment (python -m deploy.start, the Dockerfile, render.yaml; see docs/deployment.md). These are read by
# the deployment supervisor and gateway only, and are not needed for local development. Set real values in your host's
# secret settings, never in a committed file; `python -m deploy.make_secrets` generates SECRET_KEY, DEMO_PASSWORDS_JSON,
# ADMIN_UI_USER and ADMIN_UI_PASSWORD for you.
# DEPLOY_MODE=persistent        # persistent: PostgreSQL in DATABASE_URL. demo: throw-away SQLite, reset on every start
# PUBLIC_URL=https://your-service.example.com   # https public address (Render supplies RENDER_EXTERNAL_URL itself)
# ADMIN_UI_USER=                # browser login in front of the SOC dashboard (3+ characters)
# ADMIN_UI_PASSWORD=            # 16+ characters
# ALLOW_OPEN_ADMIN_UI=false     # true removes that login (only for a private, trusted network)
# PORT=8080                     # public gateway port (the host usually sets it)
# STARTUP_TIMEOUT_SECONDS=240

# Authentication defence: detection thresholds and the automatic response (see README, "Authentication defence"). Defaults shown.
# These are a starting policy; calibrate them against real sign-in traffic.
# AUTH_DEFENSE_ENABLED=true
# AUTH_AUTO_RESPONSE=true              # false = raise incidents only, change nothing
# ACCOUNT_LOCKOUT_THRESHOLD=5          # failures on one account ...
# ACCOUNT_FAILURE_WINDOW_MINUTES=5     # ... within this many minutes
# KNOWN_IP_LOCKOUT_THRESHOLD=10        # higher threshold when every failure came from the account's own registered addresses
# ACCOUNT_LOCK_MINUTES=15
# IP_ALERT_FAILURES=10
# IP_ALERT_WINDOW_MINUTES=5
# IP_BLOCK_THRESHOLD=20
# IP_BLOCK_WINDOW_MINUTES=10
# IP_BLOCK_MINUTES=60                  # application-level block, not a firewall rule
# STUFFING_ACCOUNTS_ALERT=5
# STUFFING_ACCOUNTS_CRITICAL=10
# STUFFING_WINDOW_MINUTES=10
# DISTRIBUTED_IPS=3
# DISTRIBUTED_FAILURES=6
# DISTRIBUTED_WINDOW_MINUTES=10
# SUCCESS_AFTER_FAILURES=3
# SUCCESS_AFTER_FAILURES_WINDOW_MINUTES=10
# MAX_AUTO_LOCKS_PER_HOUR=10
# MAX_AUTO_BLOCKS_PER_HOUR=10
# PROTECTED_IPS=                       # comma-separated addresses or CIDR ranges that are never blocked
# AUTH_ATTEMPT_RETENTION_DAYS=30
# Refused requests (401/403) and probing of other people's records (IDOR)
# FORBIDDEN_ALERT=10                  # 403s by one account within ACCESS_WINDOW_MINUTES: Elevated
# FORBIDDEN_CRITICAL=30               # ... Alert: the account's sessions end and it is locked
# IDOR_DISTINCT_ALERT=5               # different objects refused on one route by one account: probing
# IDOR_DISTINCT_CRITICAL=10
# UNAUTH_FLOOD_ALERT=30               # 401s from one address within ACCESS_WINDOW_MINUTES: Elevated
# UNAUTH_FLOOD_CRITICAL=100           # ... Alert: the address is blocked in this application
# ACCESS_WINDOW_MINUTES=5
# DENIAL_RECORD_LIMIT_PER_MINUTE=120  # most refused requests stored per address per minute (flood cap)
# Exports and downloads, authorized on the server before anything is processed
# EXPORT_APPROVAL_THRESHOLD=10000     # more records than this in one request waits for a security administrator
# EXPORT_HARD_LIMIT=100000            # never more than this in one request, approved or not
# EXPORT_HOURLY_LIMIT=25000           # records one account may take per rolling hour
# EXPORT_OWNER_MULTIPLIER=5           # staff with write access in the resource's own department get this many times the allowance
# EXPORT_APPROVAL_MINUTES=60          # how long an approval stays usable (single use)
# EXPORT_ATTEMPT_ALERT=3              # held or refused requests by one account within the window: Elevated
# EXPORT_ATTEMPT_CRITICAL=6           # ... Alert: the session ends and the account locks
# EXPORT_ATTEMPT_WINDOW_MINUTES=30
# TRUST_FORWARDED_FOR=false            # gateway only: true when a platform proxy in front appends the real client to X-Forwarded-For
