# Copy to .env and adjust. All values below are the defaults.
DATABASE_URL=sqlite:///./data/insider_threat.db
SECRET_KEY=change-me-for-anything-other-than-a-local-demo
SESSION_TTL_MINUTES=480
DISPLAY_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
AUTO_SEED=true
ALLOW_SIMULATED_SOURCE_IP=true
PASSWORD_HASH_ITERATIONS=260000

# Demo-only passwords applied by the seed script (synthetic accounts)
DEMO_EMPLOYEE_PASSWORD=Employee#Demo2026
DEMO_ADMIN_PASSWORD=SocAdmin#Demo2026

# Detection tuning
RISK_WINDOW_MINUTES=120
CORRELATION_WINDOW_MINUTES=240
INVESTIGATION_WINDOW_HOURS=24
RISK_MEDIUM_THRESHOLD=25
RISK_HIGH_THRESHOLD=50
RISK_CRITICAL_THRESHOLD=75
BULK_RECORD_THRESHOLD=500
BUSINESS_HOURS_START=7
BUSINESS_HOURS_END=19
